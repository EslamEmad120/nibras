// Firestore rules (starter)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{doc} {
      allow read: if true;
      // allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
    match /orders/{doc} {
      allow create: if true;
      allow read: if false; // admin only
    }
    match /{document=**} {
      allow read: if true;
    }
  }
}
